<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <handlers>
      <clear />
      <add name="Images" path="*.jpg" verb="*" type="System.Web.StaticFileHandler" />
      <add name="Images" path="*.jpeg" verb="*" type="System.Web.StaticFileHandler" />
      <add name="Images" path="*.png" verb="*" type="System.Web.StaticFileHandler" />
      <add name="Images" path="*.webp" verb="*" type="System.Web.StaticFileHandler" />
      <add name="Images" path="*.gif" verb="*" type="System.Web.StaticFileHandler" />
      <add name="Images" path="*.svg" verb="*" type="System.Web.StaticFileHandler" />
      <add name="Pdf" path="*.pdf" verb="*" type="System.Web.StaticFileHandler" />
    </handlers>
    <security>
      <requestFiltering>
        <denyUrlSequences>
          <add sequence=".php" />
          <add sequence=".phtml" />
          <add sequence=".phar" />
          <add sequence=".cgi" />
          <add sequence=".pl" />
        </denyUrlSequences>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
